                <div style="font-size:4rem; margin-bottom:20px;">👨‍🏫</div>
                <h2 style="color:white; margin-bottom:10px;">Smart Substitution System</h2>
                <p style="color:#94a3b8;">Automate teacher replacements and maintain schedules.</p>
            </div>
        `;
},

loadLeaveRequests() {
    this.currentModule = 'leave-requests';
    const container = document.getElementById('dashboardView');
    container.innerHTML = `
            <div class="module-header">
                <div>
                    <h1 class="page-title">🏖️ Leave Management System</h1>
                    <p class="page-subtitle">Approve and track staff/student leave requests</p>
                </div>
            </div>
            <div class="premium-card" style="text-align:center; padding:60px;">
                <div style="font-size:4rem; margin-bottom:20px;">📅</div>
                <h2 style="color:white; margin-bottom:10px;">Digital Leave Approval</h2>
                <p style="color:#94a3b8;">Staff and student leave tracking with approval workflows.</p>
            </div>
        `;
}

};

