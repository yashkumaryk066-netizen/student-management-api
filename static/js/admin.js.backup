DashboardApp.loadLeadManagement = async function () {
    this.currentModule = 'leads';
    const container = document.getElementById('dashboardView');
    container.innerHTML = `
        <div class="module-header">
            <div>
                 <h1 class="page-title">🤖 AI Lead Predictor (CRM)</h1>
                 <p class="page-subtitle">Smart Enquiry Tracking with Conversion Probability Scoring.</p>
            </div>
            <div style="display:flex; gap:10px;">
                <button class="btn-primary" onclick="DashboardApp.showAddLeadModal()">+ New Enquiry</button>
            </div>
        </div>

        <!-- CRM Stats -->
        <div class="stats-grid" style="margin-bottom:30px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;">📢</span> Total Enquiries</div>
                 <div class="stat-value" id="crm-total">-</div>
             </div>
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(234,179,8,0.1); color:#eab308;">🔥</span> Hot Leads</div>
                 <div class="stat-value" id="crm-hot">-</div>
             </div>
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(16,185,129,0.1); color:#10b981;">💰</span> Converts</div>
                 <div class="stat-value" id="crm-converted">-</div>
             </div>
        </div>

        <div class="data-table-container">
            <div style="padding: 20px; border-bottom: 1px solid var(--glass-border);">
                 <h3 style="color: white; margin-bottom: 5px;">Active Leads Pipeline</h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Lead Name</th>
                        <th>Contact</th>
                        <th>Status</th>
                        <th>AI Probability</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="leadsTableBody">
                    <tr><td colspan="5" class="text-center"><div class="loader"></div> Analyzing Pipeline...</td></tr>
                </tbody>
            </table>
        </div>
    `;

    try {
        const res = await fetch(`${this.apiBaseUrl}/leads/`, {
            headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
        });
        if (res.ok) {
            const leads = await res.json();
            const tbody = document.getElementById('leadsTableBody');

            // Stats
            if (document.getElementById('crm-total')) document.getElementById('crm-total').innerText = leads.length;
            if (document.getElementById('crm-hot')) document.getElementById('crm-hot').innerText = leads.filter(l => l.probability_score > 70).length;
            if (document.getElementById('crm-converted')) document.getElementById('crm-converted').innerText = leads.filter(l => l.status === 'CONVERTED').length;

            if (leads.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center" style="padding:40px; color:#64748b;">No enquiries found. Add one to see AI predictions.</td></tr>`;
                return;
            }

            tbody.innerHTML = leads.map(lead => `
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <td>
                        <div style="font-weight:bold; color:white;">${lead.name}</div>
                        <div style="font-size:0.8rem; color:#64748b;">Source: ${lead.source || 'Direct'}</div>
                    </td>
                    <td>
                        <div style="color:white;">${lead.phone}</div>
                        ${lead.course_interest ? `<div style="font-size:0.8rem; color:#3b82f6;">${lead.course_interest}</div>` : ''}
                    </td>
                    <td><span class="badge ${lead.status === 'CONVERTED' ? 'badge-success' : 'badge-primary'}">${lead.status}</span></td>
                    <td>
                         <div style="display:flex; flex-direction:column; gap:5px;">
                            <div style="display:flex; justify-content:space-between; font-size:0.8rem;">
                                <span style="color:${lead.ai_score_color}; font-weight:bold;">${lead.probability_score}% Win Rate</span>
                            </div>
                            <div style="height:6px; background:#1e293b; border-radius:3px; overflow:hidden; width: 100px;">
                                <div style="width:${lead.probability_score}%; height:100%; background:${lead.ai_score_color};"></div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <button class="btn-sm btn-outline" onclick="DashboardApp.editLead(${lead.id})">Edit</button>
                        <a href="https://wa.me/${lead.phone}" target="_blank" class="btn-sm btn-success" style="text-decoration:none;">WhatsApp</a>
                    </td>
                </tr>
            `).join('');
        }
    } catch (e) { console.error(e); }
},

