DashboardApp.loadROIAnalytics = async function () {
    const container = document.getElementById('dashboardView');
    container.innerHTML = `<div class="p-20"><div class="loading-spinner">Analyzing Institutional Performance...</div></div>`;

    try {
        const res = await fetch(`${this.apiBaseUrl}/analytics/roi/`, {
            headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
        });
        const data = await res.json();

        container.innerHTML = `
            <div class="p-20 premium-motion-up">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h1 class="text-3xl font-bold text-white">Institutional ROI & Analytics</h1>
                        <p class="text-slate-400">Financial Performance & Predictive Academic Risk Report</p>
                    </div>
                    <button class="btn-primary" onclick="window.print()">
                        <span class="nav-icon">🖨️</span> Export Annual Report
                    </button>
                </div>

                <!-- ROI CARDS -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="premium-card finance-card">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm font-medium text-slate-400">Total Revenue (Fees)</p>
                                <h2 class="text-3xl font-bold mt-2" style="color: #10b981;">₹${data.finance.total_revenue.toLocaleString()}</h2>
                            </div>
                            <div class="stats-icon bg-emerald-500/10 text-emerald-500">💰</div>
                        </div>
                    </div>
                    <div class="premium-card finance-card">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm font-medium text-slate-400">Total Operational Expenses</p>
                                <h2 class="text-3xl font-bold mt-2" style="color: #ef4444;">₹${data.finance.total_expenses.toLocaleString()}</h2>
                            </div>
                            <div class="stats-icon bg-rose-500/10 text-rose-500">📉</div>
                        </div>
                    </div>
                    <div class="premium-card finance-card">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm font-medium text-slate-400">Net Annual Profit</p>
                                <h2 class="text-3xl font-bold mt-2" style="color: #3b82f6;">₹${data.finance.net_profit.toLocaleString()}</h2>
                            </div>
                            <div class="stats-icon bg-blue-500/10 text-blue-500">🏆</div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- CHART: Expense Breakdown -->
                    <div class="premium-card">
                        <h3 class="text-xl font-bold mb-6">Expense Distribution</h3>
                        <div style="height: 300px; display: flex; justify-content: center;">
                            <canvas id="expenseChart"></canvas>
                        </div>
                    </div>

                    <!-- PREDICTIVE ANALYTICS: Students at Risk -->
                    <div class="premium-card">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-xl font-bold">Predictive Risk Report</h3>
                            <span class="badge badge-error">High Alert</span>
                        </div>
                        <p class="text-slate-400 text-sm mb-4">Students identified as likely to fail based on recent performance trends.</p>
                        <div class="table-container">
                            <table class="premium-table">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Avg. Score</th>
                                        <th>Risk Level</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${data.academic_risk.map(s => `
                                        <tr>
                                            <td>
                                                <div class="flex items-center gap-3">
                                                    <div class="avatar-sm">${s.student_name.charAt(0)}</div>
                                                    <div>
                                                        <div class="font-bold">${s.student_name}</div>
                                                        <div class="text-xs text-slate-500">Roll: ${s.roll_no}</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-rose-400 font-bold">${s.average_score}%</td>
                                            <td><span class="badge badge-error">Critical</span></td>
                                            <td><button onclick="DashboardApp.loadStudentManagement()" class="btn-sm btn-outline">Counsel</button></td>
                                        </tr>
                                    `).join('')}
                                    ${data.academic_risk.length === 0 ? '<tr><td colspan="4" class="text-center py-10">No high-risk students identified. Overall performance is healthy!</td></tr>' : ''}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        `;

        // Render Chart
        const ctx = document.getElementById('expenseChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: data.finance.expense_breakdown.map(e => e.expense_type),
                datasets: [{
                    data: data.finance.expense_breakdown.map(e => e.amount),
                    backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#64748b'],
                    borderWidth: 0
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom', labels: { color: '#94a3b8' } } },
                cutout: '70%'
            }
        });

    } catch (e) {
        console.error(e);
        this.showAlert('Analysis Failed', 'Could not generate ROI report.', 'error');
    }
};

DashboardApp.loadLMSMaterials = async function () {
    this.currentModule = 'lms_materials';
    const container = document.getElementById('dashboardView');
    container.innerHTML = `
        <div class="module-header">
            <div>
                 <h1 class="page-title">📚 LMS Study Material</h1>
                 <p class="page-subtitle">Manage video lectures, PDFs, and digital resources.</p>
            </div>
            <div style="display:flex; gap:10px;">
                <button class="btn-primary" onclick="DashboardApp.showLMSUploadModal()">+ Upload Material</button>
            </div>
        </div>

        <div class="stats-grid" style="margin-bottom:30px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;">🎥</span> Videos</div>
                 <div class="stat-value" id="lms-videos">-</div>
             </div>
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(16,185,129,0.1); color:#10b981;">📄</span> Documents</div>
                 <div class="stat-value" id="lms-docs">-</div>
             </div>
        </div>

        <div id="lmsContainer" class="cards-grid">
           <div class="module-card" style="grid-column:1/-1; text-align:center; padding:40px;">
                <div class="loader"></div> <p style="margin-top:10px; color:#64748b;">Loading Resources...</p>
           </div>
        </div>
    `;

    try {
        const res = await fetch(`${this.apiBaseUrl}/lms/materials/`, {
            headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
        });
        const materials = await res.json();

        // Update Stats
        if (document.getElementById('lms-videos')) document.getElementById('lms-videos').innerText = materials.filter(m => m.material_type === 'VIDEO').length;
        if (document.getElementById('lms-docs')) document.getElementById('lms-docs').innerText = materials.filter(m => m.material_type !== 'VIDEO').length;

        const grid = document.getElementById('lmsContainer');
        if (materials.length === 0) {
            grid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:60px; color:#64748b;">No study materials found. Upload your first lecture or PDF.</div>';
            return;
        }

        grid.innerHTML = materials.map(m => `
            <div class="module-card">
                <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:15px;">
                    <div style="background:rgba(255,255,255,0.05); padding:10px; border-radius:12px; font-size:1.5rem;">
                        ${m.material_type === 'VIDEO' ? '🎥' : '📄'}
                    </div>
                    <span class="badge ${m.material_type === 'VIDEO' ? 'badge-primary' : 'badge-success'}">${m.material_type}</span>
                </div>
                <h3 class="module-title" style="margin-bottom:5px;">${m.title}</h3>
                <p class="module-description" style="margin-bottom:15px;">Subject: ${m.subject_name || 'General'}</p>
                
                <div style="display:flex; gap:10px; margin-top:auto;">
                    ${m.material_type === 'VIDEO' ?
                `<a href="${m.video_url}" target="_blank" class="btn-primary" style="flex:1; text-align:center; text-decoration:none; font-size:0.85rem;">Watch Now</a>` :
                `<a href="${m.file_upload}" target="_blank" class="btn-success" style="flex:1; text-align:center; text-decoration:none; font-size:0.85rem;">Download PDF</a>`
            }
                    <button class="btn-outline" style="color:#ef4444; border-color:#ef4444; padding:0 10px;" onclick="DashboardApp.deleteLMSMaterial(${m.id})">🗑️</button>
                </div>
            </div>
        `).join('');

    } catch (e) {
        console.error(e);
        document.getElementById('lmsContainer').innerHTML = '<div style="color:red; text-align:center; grid-column:1/-1;">Failed to load resources.</div>';
    }
};

DashboardApp.loadInventoryManagement = async function () {
    this.currentModule = 'inventory';
    const container = document.getElementById('dashboardView');
    container.innerHTML = `
        <div class="module-header">
            <div>
                 <h1 class="page-title">📦 Inventory & Assets</h1>
                 <p class="page-subtitle">Track stationary, equipment, and low stock alerts.</p>
            </div>
            <div style="display:flex; gap:10px;">
                <button class="btn-primary" onclick="DashboardApp.showAddInventoryModal()">+ Add Item</button>
            </div>
        </div>

        <!-- Inventory Stats -->
        <div class="stats-grid" style="margin-bottom:30px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;">📦</span> Total Items</div>
                 <div class="stat-value" id="inv-total">-</div>
             </div>
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(234,179,8,0.1); color:#eab308;">📉</span> Low Stock</div>
                 <div class="stat-value" id="inv-low">-</div>
             </div>
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(16,185,129,0.1); color:#10b981;">💰</span> Total Value</div>
                 <div class="stat-value" id="inv-value">-</div>
             </div>
        </div>

        <div class="data-table-container">
             <div style="padding: 20px; border-bottom: 1px solid var(--glass-border);">
                 <h3 style="color: white; margin-bottom: 5px;">Stock Ledger</h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="inventoryTableBody">
                    <tr><td colspan="6" class="text-center"><div class="loader"></div> Loading Stock...</td></tr>
                </tbody>
            </table>
        </div>
    `;

    try {
        const res = await fetch(`${this.apiBaseUrl}/inventory/`, {
            headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
        });
        const items = await res.json();
        const tbody = document.getElementById('inventoryTableBody');

        // Update Stats
        if (document.getElementById('inv-total')) document.getElementById('inv-total').innerText = items.length;
        if (document.getElementById('inv-low')) document.getElementById('inv-low').innerText = items.filter(i => i.quantity <= i.min_stock_level).length;
        if (document.getElementById('inv-value')) document.getElementById('inv-value').innerText = '₹' + items.reduce((acc, i) => acc + (i.quantity * i.unit_price), 0).toLocaleString();

        if (items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="padding:40px; color:#64748b;">Inventory is empty. Register your institutional assets here.</td></tr>';
            return;
        }

        tbody.innerHTML = items.map(i => {
            const isLow = i.quantity <= i.min_stock_level;
            return `
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="font-weight:600; color:white;">${i.name}</td>
                <td>${i.category}</td>
                <td><span style="font-family:monospace;">${i.quantity} ${i.unit}</span></td>
                <td>₹${i.unit_price}</td>
                <td><span class="status-badge ${isLow ? 'status-overdue' : 'status-active'}">${isLow ? 'Low Stock' : 'Healthy'}</span></td>
                <td>
                    <button class="btn-sm btn-primary" onclick="DashboardApp.updateStock(${i.id})">+ Stock</button>
                </td>
            </tr>
           `;
        }).join('');

    } catch (e) {
        console.error(e);
        document.getElementById('inventoryTableBody').innerHTML = '<tr><td colspan="6" class="text-center text-error">Failed to load inventory.</td></tr>';
    }
};

DashboardApp.loadStudentDiary = async function () {
    this.currentModule = 'diary';
    const container = document.getElementById('dashboardView');
    container.innerHTML = `<div class="p-20"><div class="loading-spinner">Reading Daily Diary...</div></div>`;

    try {
        const res = await fetch(`${this.apiBaseUrl}/diary/`, {
            headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
        });
        const diaries = await res.json();

        container.innerHTML = `
            <div class="module-header">
                <div>
                     <h1 class="page-title">📔 Daily Academic Diary</h1>
                     <p class="page-subtitle">Synchronized homework, assignments, and daily tasks tracker.</p>
                </div>
                <div style="display:flex; gap:10px;">
                    <button class="btn-primary" onclick="DashboardApp.showDiaryModal()">+ Post Entry</button>
                </div>
            </div>

            <!-- Diary Stats -->
            <div class="stats-grid" style="margin-bottom:30px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
                 <div class="stat-card">
                     <div class="stat-header"><span class="stat-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;">📅</span> Tasks Today</div>
                     <div class="stat-value" id="diary-today">-</div>
                 </div>
                 <div class="stat-card">
                     <div class="stat-header"><span class="stat-icon" style="background:rgba(239,68,68,0.1); color:#ef4444;">⏳</span> Due Soon</div>
                     <div class="stat-value" id="diary-due">-</div>
                 </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="diaryGrid">
                <div style="grid-column:1/-1; text-align:center;"><div class="loader"></div></div>
            </div>
        `;

        // Stats Calculation
        const today = new Date().toISOString().split('T')[0];
        const dueSoon = diaries.filter(d => new Date(d.due_date) > new Date() && new Date(d.due_date) < new Date(Date.now() + 3 * 86400000)).length;

        if (document.getElementById('diary-today')) document.getElementById('diary-today').innerText = diaries.filter(d => d.created_at.startsWith(today)).length;
        if (document.getElementById('diary-due')) document.getElementById('diary-due').innerText = dueSoon;

        const grid = document.getElementById('diaryGrid');

        if (diaries.length === 0) {
            grid.innerHTML = '<div class="col-span-full text-center py-20 text-slate-500">No diary entries used. Start assigning homework!</div>';
            return;
        }

        grid.innerHTML = diaries.map(d => `
            <div class="premium-card" style="border-left: 5px solid ${d.task_type === 'HOMEWORK' ? '#3b82f6' : '#10b981'};">
                <div class="flex justify-between items-start mb-2">
                    <h3 class="text-xl font-bold text-white">${d.task_title}</h3>
                    <span class="text-xs text-slate-500">${new Date(d.created_at).toLocaleDateString()}</span>
                </div>
                <p class="text-indigo-400 font-medium mb-3">
                    <span class="badge" style="background:rgba(255,255,255,0.1); margin-right:5px;">${d.subject_name}</span>
                    <span style="color:#94a3b8;">${d.grade_class}</span>
                </p>
                <div class="bg-slate-900/50 p-4 rounded-xl border border-white/5 mb-4">
                    <p class="text-slate-300" style="white-space: pre-wrap;">${d.description}</p>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-sm font-bold" style="color: #f59e0b;">Due: ${new Date(d.due_date).toLocaleDateString()}</span>
                    <button class="btn-sm btn-outline" style="color:#ef4444; border-color:#ef4444;" onclick="DashboardApp.deleteDiary(${d.id})">Delete</button>
                </div>
            </div>
        `).join('');

    } catch (e) {
        console.error(e);
        document.getElementById('dashboardView').innerHTML += '<div style="color:red; text-align:center;">Failed to load diary.</div>';
    }
};

DashboardApp.loadLMSAssignments = async function () {
    this.currentModule = 'lms_assignments';
    const container = document.getElementById('dashboardView');
    container.innerHTML = `
        <div class="module-header">
            <div>
                 <h1 class="page-title">📝 Digital Assignments</h1>
                 <p class="page-subtitle">Assign, Track, and Grade submissions online.</p>
            </div>
            <div style="display:flex; gap:10px;">
                <button class="btn-primary" onclick="DashboardApp.showAssignmentModal()">+ Create Assignment</button>
            </div>
        </div>

        <!-- Assignment Stats -->
        <div class="stats-grid" style="margin-bottom:30px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;">📁</span> Active Tasks</div>
                 <div class="stat-value" id="asn-active">-</div>
             </div>
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(16,185,129,0.1); color:#10b981;">📥</span> Submissions</div>
                 <div class="stat-value" id="asn-subs">-</div>
             </div>
        </div>

        <div id="asnContainer" class="cards-grid">
           <div class="module-card" style="grid-column:1/-1; text-align:center; padding:40px;">
                <div class="loader"></div> <p style="margin-top:10px; color:#64748b;">Loading Assignments...</p>
           </div>
        </div>
    `;

    try {
        const res = await fetch(`${this.apiBaseUrl}/lms/assignments/`, {
            headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
        });
        const assignments = await res.json();

        // Stats
        if (document.getElementById('asn-active')) document.getElementById('asn-active').innerText = assignments.length;
        if (document.getElementById('asn-subs')) document.getElementById('asn-subs').innerText = assignments.reduce((acc, curr) => acc + (curr.submission_count || 0), 0);

        const grid = document.getElementById('asnContainer');
        if (assignments.length === 0) {
            grid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:60px; color:#64748b;">No active assignments found. Build your digital classroom here.</div>';
            return;
        }

        grid.innerHTML = assignments.map(a => `
            <div class="module-card">
                <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:15px;">
                    <div>
                        <h3 class="module-title" style="margin-bottom:5px;">${a.title}</h3>
                        <p class="module-description">Subject: ${a.subject_name}</p>
                    </div>
                    <div style="text-align:right;">
                        <span style="font-size:1.5rem; font-weight:bold; color:#8b5cf6;">${a.submission_count || 0}</span>
                        <div style="font-size:0.7rem; color:#94a3b8; text-transform:uppercase; letter-spacing:1px;">Submissions</div>
                    </div>
                </div>
                <p style="color:#cbd5e1; font-size:0.9rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-bottom:15px;">${a.description}</p>
                
                <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid rgba(255,255,255,0.05); padding-top:15px; margin-top:auto;">
                    <span style="font-size:0.8rem; font-weight:bold; color:#ef4444;">Due: ${new Date(a.due_date).toLocaleDateString()}</span>
                    <button class="btn-primary" style="padding:5px 15px; font-size:0.85rem;" onclick="DashboardApp.viewSubmissions(${a.id})">View Desk</button>
                </div>
            </div>
        `).join('');

    } catch (e) {
        console.error(e);
        document.getElementById('asnContainer').innerHTML = '<div style="color:red; text-align:center; grid-column:1/-1;">Failed to load assignments.</div>';
    }
};

DashboardApp.loadLeaveRequests = async function () {
    this.currentModule = 'leaves';
    const container = document.getElementById('dashboardView');
    container.innerHTML = `
        <div class="module-header">
            <div>
                 <h1 class="page-title">📅 Leave Management</h1>
                 <p class="page-subtitle">Review and manage student/staff leave applications.</p>
            </div>
        </div>

        <!-- Leave Stats -->
        <div class="stats-grid" style="margin-bottom:30px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(234,179,8,0.1); color:#eab308;">⏳</span> Pending</div>
                 <div class="stat-value" id="lv-pending">-</div>
             </div>
             <div class="stat-card">
                 <div class="stat-header"><span class="stat-icon" style="background:rgba(16,185,129,0.1); color:#10b981;">✅</span> Approved</div>
                 <div class="stat-value" id="lv-approved">-</div>
             </div>
        </div>

        <div class="data-table-container">
             <div style="padding: 20px; border-bottom: 1px solid var(--glass-border);">
                 <h3 style="color: white; margin-bottom: 5px;">Leave Requests</h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th>Duration</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="leaveTableBody">
                    <tr><td colspan="5" class="text-center"><div class="loader"></div> Loading requests...</td></tr>
                </tbody>
            </table>
        </div>
    `;

    try {
        const res = await fetch(`${this.apiBaseUrl}/leave-requests/`, {
            headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
        });
        const requests = await res.json();
        const tbody = document.getElementById('leaveTableBody');

        // Stats
        if (document.getElementById('lv-pending')) document.getElementById('lv-pending').innerText = requests.filter(r => r.status === 'PENDING').length;
        if (document.getElementById('lv-approved')) document.getElementById('lv-approved').innerText = requests.filter(r => r.status === 'APPROVED').length;

        if (requests.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center" style="padding:40px; color:#64748b;">No leave requests found.</td></tr>';
            return;
        }

        tbody.innerHTML = requests.map(r => `
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td>
                    <div style="font-weight:600; color:white;">${r.student_name || 'Staff'}</div>
                    <div style="font-size:0.8rem; color:#64748b;">ID: #${r.student || r.employee}</div>
                </td>
                <td>
                    <div style="color:white;">${r.start_date} → ${r.end_date}</div>
                    <div style="font-size:0.8rem; color:#64748b;">${r.days_count || '1'} days</div>
                </td>
                <td><div style="max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${r.reason}">${r.reason}</div></td>
                <td><span class="status-badge status-${r.status === 'APPROVED' ? 'active' : r.status === 'REJECTED' ? 'inactive' : 'pending'}">${r.status}</span></td>
                <td>
                     ${r.status === 'PENDING' ? `
                        <button onclick="DashboardApp.updateLeaveStatus(${r.id}, 'APPROVED')" class="btn-sm btn-primary">Approve</button>
                        <button onclick="DashboardApp.updateLeaveStatus(${r.id}, 'REJECTED')" class="btn-sm btn-outline" style="color:#ef4444; border-color:#ef4444;">Reject</button>
                    ` : '-'}
                </td>
            </tr>
        `).join('');

    } catch (e) {
        console.error(e);
        document.getElementById('leaveTableBody').innerHTML = '<tr><td colspan="5" class="text-center text-error">Failed to load requests.</td></tr>';
    }
};

DashboardApp.updateLeaveStatus = async function (id, status) {
    if (!confirm(`Are you sure you want to ${status.toLowerCase()} this leave?`)) return;

    try {
        const res = await fetch(`${this.apiBaseUrl}/leave-requests/${id}/`, {
            method: 'PATCH',
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('authToken')}`,
                'Content-Type': 'application/json',
                'X-CSRFToken': this.getCsrfToken()
            },
            body: JSON.stringify({ status })
        });
        if (res.ok) {
            this.showAlert('Success', `Leave request has been ${status.toLowerCase()}.`, 'success');
            this.loadLeaveRequests();
        }
    } catch (e) { console.error(e); }
};

// =====================================================
// MOBILE APP INSTALLATION (PWA / APK EXPERIENCE)
// =====================================================

let deferredPrompt;
window.addEventListener('beforeinstallprompt', (e) => {
    // Prevent the mini-infobar from appearing on mobile
    e.preventDefault();
    // Stash the event so it can be triggered later.
    deferredPrompt = e;
    // Update UI notify the user they can install the PWA
    const installItem = document.getElementById('pwaInstallItem');
    if (installItem) installItem.style.display = 'block';
    console.log('✨ Mobile App Installation Ready (APK Mode Enabled)');
});

// Handle Install Button Click
document.addEventListener('DOMContentLoaded', () => {
    const installBtn = document.getElementById('pwaInstallBtn');
    if (installBtn) {
        installBtn.addEventListener('click', async () => {
            if (!deferredPrompt) {
                DashboardApp.showAlert('App Ready', 'The app is already installed or ready to use from your home screen!', 'success');
                return;
            }
            // Show the install prompt
            deferredPrompt.prompt();
            // Wait for the user to respond to the prompt
            const { outcome } = await deferredPrompt.userChoice;
            console.log(`User response to install prompt: ${outcome}`);
            // We've used the prompt, and can't use it again, throw it away
            deferredPrompt = null;
            // Hide the install button
            const installItem = document.getElementById('pwaInstallItem');
            if (installItem) installItem.style.display = 'none';
        });
    }
});

window.addEventListener('appinstalled', (event) => {
    console.log('🚀 Sovereign App installed successfully!');
    DashboardApp.showAlert('Success', 'Sovereign Mobile App has been installed on your home screen.', 'success');
});

// =====================================================
// SOVEREIGN SMART GATEKEEPER (QR SCANNER)
// =====================================================

DashboardApp.openScannerModal = function () {
    // 1. Create Modal HTML on fly
    const modalHtml = `
        <div id="scannerModal" class="modal-overlay" style="display:flex;">
            <div class="modal-content" style="background:#0f172a; color:white; max-width:500px;">
                <div class="modal-header">
                    <h2>📸 Scan Student ID</h2>
                    <button class="close-btn" onclick="DashboardApp.closeScannerModal()">×</button>
                </div>
                <div class="modal-body" style="text-align:center;">
                    <div id="reader" style="width:100%; border-radius:10px; overflow:hidden;"></div>
                    <p style="margin-top:15px; color:#94a3b8;">Point camera at student ID card to mark presence.</p>
                    <div id="scanResult" style="margin-top:20px; font-weight:bold; min-height:20px;"></div>
                </div>
            </div>
        </div>
    `;

    // Remove existing if any
    const existing = document.getElementById('scannerModal');
    if (existing) existing.remove();

    document.body.insertAdjacentHTML('beforeend', modalHtml);

    // 2. Initialize Scanner
    // We utilize html5-qrcode library
    if (typeof Html5QrcodeScanner === 'undefined') {
        this.showAlert('Error', 'Scanner engine not loaded. Please refresh.', 'error');
        return;
    }

    const html5QrcodeScanner = new Html5QrcodeScanner(
        "reader", { fps: 10, qrbox: 250 });

    html5QrcodeScanner.render(onScanSuccess, onScanFailure);

    // Store reference to clear later
    this.currentScanner = html5QrcodeScanner;

    function onScanSuccess(decodedText, decodedResult) {
        // Handle the scanned code
        console.log(`Code matched = ${decodedText}`, decodedResult);
        document.getElementById('scanResult').innerHTML = '<span style="color:#facc15;">Verifying...</span>';
        DashboardApp.verifyAttendance(decodedText);

        // Optional: Pause scanning to prevent multi-scan
        html5QrcodeScanner.pause();
        setTimeout(() => html5QrcodeScanner.resume(), 3000);
    }

    function onScanFailure(error) {
        // handle scan failure, usually better to ignore and keep scanning.
    }
};

DashboardApp.closeScannerModal = function () {
    const modal = document.getElementById('scannerModal');
    if (modal) {
        if (this.currentScanner) {
            this.currentScanner.clear().catch(error => console.error(error));
        }
        modal.remove();
    }
};

DashboardApp.verifyAttendance = async function (qrCode) {
    try {
        const res = await fetch(`${this.apiBaseUrl}/attendance/scan/`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('authToken')}`,
                'X-CSRFToken': this.getCsrfToken()
            },
            body: JSON.stringify({ qr_code: qrCode })
        });

        const data = await res.json();
        const resultDiv = document.getElementById('scanResult');

        if (res.ok && data.success) {
            resultDiv.innerHTML = `
                <div style="color:#10b981; font-size:1.2rem;">✅ ${data.status_msg || 'Verified'}</div>
                <div style="font-size:1.5rem; margin-top:5px;">${data.student_name}</div>
                <div style="color:#64748b; font-size:0.9rem;">${data.time}</div>
            `;
            if (data.photo) {
                resultDiv.innerHTML += `<img src="${data.photo}" style="width:100px; height:100px; border-radius:50%; margin-top:10px; border:2px solid #10b981;">`;
            }
            // Audio Feedback
            const audio = new Audio('/static/sounds/success.mp3'); // Ensure this exists or use browser beep logic
            audio.play().catch(e => console.log('Audio not supported'));
        } else {
            resultDiv.innerHTML = `<div style="color:#ef4444;">❌ ${data.error || 'Scan Failed'}</div>`;
        }
    } catch (e) {
        console.error(e);
        document.getElementById('scanResult').innerHTML = `<div style="color:#ef4444;">❌ Connection Error</div>`;
    }
};

