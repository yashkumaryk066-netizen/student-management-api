from django.db.models import Q
from datetime import date

# --- CONSTANTS ---
SUB_ACTIVE = 'ACTIVE'
PAYMENT_APPROVED = 'APPROVED'
PAYMENT_PENDING = 'PENDING_VERIFICATION'

from student.models import Employee, UserProfile, ClientSubscription, AuditLog
