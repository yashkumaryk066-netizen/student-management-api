class InstitutionROIView(APIView):
    """
    Advanced Finance and Academic Analytics for Owners.
    Predictive Failures, Expense vs Profit, and Inventory Health.
    """
    authentication_classes = [JWTAuthentication]
    permission_classes = [IsAuthenticated]

    def get(self, request):
        import logging
        import traceback
        logger = logging.getLogger(__name__)

        try:
            from django.db.models import Q, Sum, Avg, F
            from student.models import Payment, InstitutionExpense, Student, Grade, InventoryItem
            # Explicitly importing serializers here to avoid circular or missing reference
            from student.serializers import InventoryItemSerializer, InstitutionExpenseSerializer

            owner = get_owner_user(request.user)
            logger.info(f"ROI Analytics Request: User={request.user.id}, Owner={owner.id}")
            
            # Security Check for specific Roles
            if not request.user.is_superuser:
                 # Ensure we have a profile to check
                 if not hasattr(request.user, 'profile'):
                     return Response({"error": "Profile not found"}, status=403)
                 
                 # Allow CLIENT (Owner), ADMIN (School Admin), STAFF (if permitted)
                 if request.user.profile.role not in ['CLIENT', 'ADMIN', 'STAFF']:
                      return Response({"error": "Access Denied: ROI Analytics is for Admin/Staff use only."}, status=403)
            
            # 1. Financial Contrast (Fee Income vs Expenses)
            # Find payments where student belongs to owner OR directly assigned to owner user
            total_income_qs = Payment.objects.filter(payment_type='FEE', status='PAID').filter(
                Q(student__created_by=owner) | Q(user=owner)
            )
            total_income = total_income_qs.aggregate(total=Sum('amount'))['total'] or 0
            
            total_expenses = InstitutionExpense.objects.filter(created_by=owner).aggregate(total=Sum('amount'))['total'] or 0
            
            # Breakdown by category
            expense_breakdown = list(
                InstitutionExpense.objects.filter(created_by=owner)
                .values('expense_type')
                .annotate(total_amount=Sum('amount'))
                .order_by('-total_amount')
            )
            
            roi_data = {
                'total_revenue': float(total_income),
                'total_expenses': float(total_expenses),
                'net_profit': float(total_income - total_expenses),
                'expense_breakdown': expense_breakdown
            }

            # 2. Predictive Performance (Who might fail?)
            # Optimization: Aggregated query instead of per-student loop
            failures_risk_qs = Grade.objects.filter(student__created_by=owner).values(
                'student__id', 'student__name', 'student__roll_number'
            ).annotate(
                avg_score=Avg('marks_obtained')
            ).filter(avg_score__lt=40)

            failures_risk = [
                {
                    'id': item['student__id'],
                    'student_name': item['student__name'],
                    'roll_no': item['student__roll_number'],
                    'average_score': float(round(item['avg_score'], 2)),
                    'risk_level': 'HIGH'
                } for item in failures_risk_qs
            ]

            # 3. Inventory Health
            low_stock = InventoryItem.objects.filter(created_by=owner, quantity__lte=F('min_stock_level'))
            
            return Response({
                'finance': roi_data,
                'academic_risk': failures_risk[:10], # Top 10 at risk students
                'inventory_alerts': InventoryItemSerializer(low_stock, many=True).data
            })
        except Exception as e:
            logger.error(f"ROI Analytics Error: {str(e)}")
            logger.error(traceback.format_exc())
            return Response({
                "error": "Failed to calculate analytics",
                "detail": str(e),
                "trace": traceback.format_exc() if request.user.is_superuser else None
            }, status=500)

# F import needed for Inventory
from django.db.models import F

# ===============================================
# SOVEREIGN AI INTELLIGENCE API LAYER
# ===============================================
from student.ai_engine import SovereignEngine
from student.models import StudentLead, SubstituteAllocation
from student.serializers import StudentLeadSerializer, SubstituteAllocationSerializer

class StudentLeadViewSet(viewsets.ModelViewSet):
    """
    AI-Managed Leads for Coaching Centers.
    Includes automated probability scoring and status tracking.
    """
    permission_classes = [IsAuthenticated]
    serializer_class = StudentLeadSerializer

    def get_queryset(self):
        return filter_by_owner(StudentLead.objects.all(), self.request.user)
        
    def perform_create(self, serializer):
        # Auto-calculate score on creation
        obj = serializer.save(created_by=get_owner_user(self.request.user))
        SovereignEngine.calculate_lead_probability(obj.id)
        
    def perform_update(self, serializer):
        # Re-calc score on update (status change, etc)
        obj = serializer.save()
        SovereignEngine.calculate_lead_probability(obj.id)

    @action(detail=True, methods=['post'], url_path='predict-conversion')
    def predict_conversion(self, request, pk=None):
        """
        Manually trigger AI Probability check for a specific lead.
        """
        score = SovereignEngine.calculate_lead_probability(pk)
        return Response({'success': True, 'new_score': score, 'message': 'AI analysis complete. Score updated.'})


class SubstituteAllocationViewSet(viewsets.ModelViewSet):
    """
    Automated Substitute Management for Schools.
    """
    permission_classes = [IsAuthenticated]
    serializer_class = SubstituteAllocationSerializer

    def get_queryset(self):
        return filter_by_owner(SubstituteAllocation.objects.all(), self.request.user)

    @action(detail=False, methods=['post'], url_path='auto-allocate')
    def trigger_auto_allocation(self, request):
        """
        Force triggers the daily substitution AI.
        Ideally run by Cron Job, but can be manual.
        """
        allocations = SovereignEngine.process_daily_substitutions(timezone.now().date())
        return Response({
            'success': True,
            'allocated_count': len(allocations),
            'allocations': SubstituteAllocationSerializer(allocations, many=True).data
        })

class AttendanceScanView(APIView):
    """
    Smart Gatekeeper API.
    Handles QR Code scans for instant attendance.
    """
    permission_classes = [IsAuthenticated]

    def post(self, request):
        qr_code = request.data.get('qr_code')
        lat = request.data.get('lat')
        lon = request.data.get('long')
        import logging
        logger = logging.getLogger(__name__)
        
        logger.info(f"AttendanceScan Attempt: User={request.user.id} | Raw QR='{qr_code}'")
        
        if not qr_code:
            return Response({'error': 'No QR code provided'}, status=400)

        # --- Geo-fence enforcement (required) ---
        try:
            lat = float(lat)
            lon = float(lon)
            if not validate_coordinates(lat, lon):
                return Response({'error': 'Invalid GPS coordinates range'}, status=400)
        except (TypeError, ValueError):
            return Response({'error': 'Valid GPS coordinates (lat/long) required'}, status=400)

        target_profile = self.get_institution_profile(request.user)
        if not target_profile or not target_profile.location_lat or not target_profile.location_long:
            return Response({
                'error': 'Institution location not configured by Administrator.',
                'code': 'LOCATION_NOT_SET'
            }, status=400)

        distance = haversine(
            lon, lat,
            target_profile.location_long,
            target_profile.location_lat
        )

        if distance > target_profile.attendance_radius:
            logger.warning(
                f"OUT_OF_RANGE QR Attendance: User={request.user.id}, Dist={int(distance)}m, "
                f"Limit={target_profile.attendance_radius}m"
            )
            return Response({
                'error': 'Out of attendance range',
                'distance': int(distance),
                'limit': target_profile.attendance_radius
            }, status=status.HTTP_403_FORBIDDEN)
            
        try:
            # Handle legacy format: "TYPE|STUDENT_ID|INFO"
            student_id_str = str(qr_code).strip()
            if '|' in student_id_str:
                parts = student_id_str.split('|')
                if len(parts) >= 2:
                    student_id_str = parts[1]
            
            # Clean non-numeric characters just in case
            import re
            student_id_str = re.sub(r'[^0-9]', '', student_id_str)
            
            if not student_id_str:
                return Response({'error': f'Invalid ID format in QR: {qr_code}'}, status=400)

            student_id = int(student_id_str)
            # Find the student and verify ownership using the standard security filter
            student_qs = Student.objects.filter(Q(id=student_id) | Q(roll_number=student_id_str) | Q(admission_number=student_id_str))
            student = filter_by_owner(student_qs, request.user).first()
            
            if not student:
                logger.warning(f"AttendanceScan Failed: No student found for ID/Roll '{student_id_str}'")
                raise Student.DoesNotExist
            
            # Mark Attendance
            date = timezone.now().date()
            existing = Attendence.objects.filter(student=student, date=date).first()
            
            status_msg = ""
            metadata = {
                "distance_meters": int(distance),
                "lat": lat,
                "lon": lon,
                "timestamp": timezone.now().isoformat(),
                "method": "QR_GEOFENCED",
                "scanner_user_id": request.user.id
            }
            if existing:
                if not existing.is_present:
                    existing.is_present = True
                    existing.metadata = metadata
                    existing.save()
                    status_msg = "Updated to PRESENT"
                else:
                    status_msg = "Already PRESENT"
            else:
                Attendence.objects.create(
                    student=student,
                    date=date,
                    is_present=True,
                    created_by=request.user,
                    metadata=metadata
                )
                status_msg = "Marked PRESENT"
                
            logger.info(f"AttendanceScan Success: Student={student.name} ({student.id})")
            
            response_data = {
                'success': True,
                'student_name': student.name,
                'time': timezone.now().strftime('%H:%M:%S'),
                'status_msg': status_msg,
                'message': f"Scan Verified: {status_msg}"
            }
            
            if student.photo:
                response_data['photo'] = request.build_absolute_uri(student.photo.url)
            elif hasattr(student, 'profile_picture') and student.profile_picture:
                response_data['photo'] = request.build_absolute_uri(student.profile_picture.url)
                
            return Response(response_data)
            
        except (Student.DoesNotExist, ValueError):
            error_msg = 'Invalid Student QR Code for this Institution'
            if request.user.is_superuser:
                 error_msg += f" (Scanned: {student_id_str})"
            return Response({'error': error_msg}, status=404)
        except Exception as e:
            logger.error(f"AttendanceScan Error: {str(e)}", exc_info=True)
            return Response({'error': f'Internal Error: {str(e)}' if request.user.is_superuser else 'Internal Server Error'}, status=500)

    def get_institution_profile(self, user):
        """Find the institution profile governing this user"""
        from django.core.exceptions import ObjectDoesNotExist
        try:
            if hasattr(user, 'profile') and user.profile.role == "CLIENT":
                return user.profile
        except ObjectDoesNotExist:
            pass

        try:
            return user.student_profile.created_by.profile
        except Exception:
            pass

        try:
            return user.employee_profile.created_by.profile
        except Exception:
            pass

        owner = get_owner_user(user)
        return getattr(owner, 'profile', None)

class VerifyIdentityView(APIView):
    """
    Public Endpoint to verify Institution Name for the landing page modal.
    No Authentication Required (It's a pre-login check).
    """
    permission_classes = [permissions.AllowAny]

    def post(self, request):
        import logging
        logger = logging.getLogger(__name__)
        
        # Robust extraction
        name = request.data.get('name', '')
        if not name:
            name = request.POST.get('name', '')
            
        name = str(name).strip()
        
        logger.info(f"VerifyIdentityView Check: '{name}' | Body: {request.data}")
        
        if not name:
            return Response({"error": "Name is required"}, status=400)
            
        # 1. Super Admin Check (Hardcoded Secret)
        if name.lower() in ['yash a mishra', 'yash ankush mishra', 'yash mishra']:
             return Response({
                 "exists": True, 
                 "type": "SUPER_ADMIN", 
                 "redirect": "/login/?role=super_admin&context=developer",
                 "welcome_msg": "Welcome, Architect Yash Ankush Mishra. Accessing Core Systems."
             })

        # 2. Database Check
        # Search for UserProfiles with this institution name (Case-insensitive)
        from student.models import UserProfile
        
        # We check both institution_name and user's full name (for solo tutors)
        profile = UserProfile.objects.filter(institution_name__iexact=name).first()
        
        if not profile:
            # Fallback: Check User's full name if they are a coaching tutor
            # We need to join with User table
            profile = UserProfile.objects.filter(user__first_name__icontains=name).first()

        if profile:
            # Found
            raw_name = profile.institution_name or profile.user.get_full_name()
            return Response({
                "exists": True,
                "type": profile.institution_type or "INSTITUTE",
                "name": raw_name,
                "redirect": "/login/",
                "welcome_msg": f"Welcome back to {raw_name}. System Online."
            })
        else:
            return Response({"exists": False, "error": "Institution Verification Failed. Name not found."}, status=404)
