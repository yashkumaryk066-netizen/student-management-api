# --- NEW: ERP 2.0 ADVANCED VIEWSETS ---
# =====================================================
from rest_framework import viewsets
from decimal import Decimal
from django.db.models import Sum, Avg
from .models import (
    StudentDiary, StudentLeaveRequest, LMSMaterial, LMSAssignment, 
    AssignmentSubmission, InventoryItem, InstitutionExpense
)
from .serializers import (
    StudentDiarySerializer, StudentLeaveRequestSerializer, LMSMaterialSerializer, 
    LMSAssignmentSerializer, AssignmentSubmissionSerializer, InventoryItemSerializer, 
    InstitutionExpenseSerializer
)

class StudentDiaryViewSet(viewsets.ModelViewSet):
    permission_classes = [IsAuthenticated]
    serializer_class = StudentDiarySerializer

    def get_queryset(self):
        return filter_by_owner(StudentDiary.objects.all(), self.request.user)

    def perform_create(self, serializer):
        serializer.save(created_by=get_owner_user(self.request.user))

class StudentLeaveRequestViewSet(viewsets.ModelViewSet):
    permission_classes = [IsAuthenticated]
    serializer_class = StudentLeaveRequestSerializer

    def get_queryset(self):
        user = self.request.user
        if hasattr(user, 'student_profile'):
            return StudentLeaveRequest.objects.filter(student=user.student_profile)
        
        # Check if Parent
        if user.profile.role == 'PARENT':
            return StudentLeaveRequest.objects.filter(student__parent=user)
            
        return filter_by_owner(StudentLeaveRequest.objects.all(), user)

    def perform_create(self, serializer):
        owner = get_owner_user(self.request.user)
        serializer.save(
            created_by=owner,
            applied_by=self.request.user
        )

    def perform_update(self, serializer):
        instance = serializer.save()
        
        # 1. Trigger System Notification
        from student.notifications import send_erp_notification
        user_to_notify = instance.student.user if instance.student.user else instance.student.created_by
        if user_to_notify:
            send_erp_notification(
                user_to_notify,
                f"Leave Request {instance.status}",
                f"Your leave request for {instance.start_date} to {instance.end_date} has been {instance.status.lower()}."
            )
            
        # 2. Trigger Premium Email Notification
        from student.services.email_service import send_leave_status_email
        send_leave_status_email(
            student=instance.student,
            leave_request=instance,
            status=instance.status,
            admin_remarks=instance.admin_remarks
        )

class LMSMaterialViewSet(viewsets.ModelViewSet):
    permission_classes = [IsAuthenticated]
    serializer_class = LMSMaterialSerializer

    def get_queryset(self):
        return filter_by_owner(LMSMaterial.objects.all(), self.request.user)

class LMSAssignmentViewSet(viewsets.ModelViewSet):
    permission_classes = [IsAuthenticated]
    serializer_class = LMSAssignmentSerializer

    def get_queryset(self):
        return filter_by_owner(LMSAssignment.objects.all(), self.request.user)

    def perform_create(self, serializer):
        assignment = serializer.save(created_by=get_owner_user(self.request.user))
        # Notify students of the new assignment
        from student.notifications import send_erp_notification
        from student.models import Student
        students = Student.objects.filter(student_class=assignment.grade_class, created_by=assignment.created_by)
        for s in students:
            if s.user:
                send_erp_notification(
                    s.user,
                    f"New Assignment: {assignment.title}",
                    f"A new assignment for {assignment.subject.name} has been posted. Due date: {assignment.due_date.strftime('%Y-%m-%d %H:%M')}."
                )

class AssignmentSubmissionViewSet(viewsets.ModelViewSet):
    permission_classes = [IsAuthenticated]
    serializer_class = AssignmentSubmissionSerializer

    def get_queryset(self):
        user = self.request.user
        if hasattr(user, 'student_profile'):
            return AssignmentSubmission.objects.filter(student=user.student_profile)
        return filter_by_owner(AssignmentSubmission.objects.all(), user)

