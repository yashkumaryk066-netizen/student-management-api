<?xml version='1.0' encoding='utf-8'?>
<widget id="com.sovereign.academic.erp" version="2.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Sovereign ERP</name>
    <description>
        Sovereign Academic &amp; Institutional ERP - Enterprise Mobile Edition.
    </description>
    <author email="admin@sovereign-erp.com" href="https://sovereign-erp.com">
        Sovereign Tech Solutions
    </author>
    
    <!-- Deep Research: Linking the app to the secure web gateway -->
    <content src="index_mobile.html" />
    
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xff0f172a" /> <!-- Matching our Dashboard Dark Mode -->
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="FadeSplashScreenDuration" value="300" />
    
    <platform name="android">
        <resource-file src="../../static/img/icon-512.png" target="app/src/main/res/mipmap-xxxhdpi/ic_launcher.png" />
        <icon src="../../static/img/icon-512.png" />
        <preference name="AndroidPersistentFileLocation" value="Internal" />
    </platform>
</widget>
